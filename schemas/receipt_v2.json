{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AIwork4me/ultralytics-windows-radeon-ep/schemas/receipt_v2.json",
  "title": "UWR per-case validation receipt v2 (orthogonal classifications)",
  "type": "object",
  "required": [
    "schema_version", "receipt_version", "run_id", "case_id", "created_utc",
    "status", "verdicts", "host", "model", "input", "expected_outputs", "worker",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "receipt_version": { "type": "integer", "minimum": 2 },
    "run_id": { "type": "string", "minLength": 4 },
    "case_id": { "type": "string", "minLength": 4 },
    "created_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "rerun_of": { "type": ["string", "null"] },
    "status": {
      "type": "object",
      "required": ["model_asset", "export", "cpu_oracle", "amdgpu", "dml", "task_oracle", "benchmark", "host"],
      "additionalProperties": false,
      "properties": {
        "model_asset": { "enum": ["AVAILABLE", "ASSET_GATED", "MISSING_WITH_REASON", "LICENSE_RESTRICTED"] },
        "export": { "enum": ["PASS_ONNX_EXPORT", "FAIL_EXPORT", "EXPORT_UNSUPPORTED", "NOT_APPLICABLE"] },
        "cpu_oracle": { "enum": ["PASS_CPU_REFERENCE", "FAIL_CPU_REFERENCE", "NOT_RUN"] },
        "amdgpu": { "enum": ["PASS_GPU_EXECUTED_FULL", "PASS_GPU_EXECUTED_PARTIAL", "FAIL_NO_GPU_COMPUTE", "FAIL_GPU_PARITY", "FAIL_RUNTIME", "FAIL_TASK", "BLOCKED_EP", "BLOCKED_IDENTITY", "BLOCKED_RESOURCE", "NOT_RUN"] },
        "dml": { "enum": ["PASS_GPU_EXECUTED_FULL", "PASS_GPU_EXECUTED_PARTIAL", "FAIL_NO_GPU_COMPUTE", "FAIL_GPU_PARITY", "FAIL_RUNTIME", "FAIL_TASK", "BLOCKED_EP", "BLOCKED_IDENTITY", "BLOCKED_RESOURCE", "NOT_RUN"] },
        "task_oracle": { "enum": ["PASS_TASK", "FAIL_TASK", "PT_APP_SMOKE_ONLY", "TASK_PARITY_NOT_IMPLEMENTED", "TASK_ORACLE_BLOCKED", "ORACLE_UNAVAILABLE", "NOT_RUN"] },
        "benchmark": { "enum": ["PASS_MEASURED", "NOT_MEASURED", "BLOCKED"] },
        "host": { "enum": ["VERIFIED_GFX1151", "VERIFIED_GFX1100", "VERIFIED_GFX1201", "BLOCKED_ENV"] }
      }
    },
    "verdicts": { "$ref": "#/definitions/verdicts" },
    "status_reasons": { "type": "object", "additionalProperties": { "type": "string" } },
    "host": { "$ref": "#/definitions/host_block" },
    "model": { "$ref": "#/definitions/model_block" },
    "input": { "$ref": "#/definitions/input_block" },
    "expected_outputs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["name", "dtype"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "dtype": { "type": "string", "minLength": 3 },
          "shape": { "type": "array", "items": { "type": ["integer", "null"] } }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": ["exit_code"],
      "properties": {
        "exit_code": { "type": "integer" },
        "pid": { "type": ["integer", "null"] },
        "parent_pid": { "type": ["integer", "null"] },
        "python": { "type": "string" }
      }
    },
    "session": { "anyOf": [ { "$ref": "#/definitions/session_block" }, { "type": "null" } ] },
    "device_binding": { "anyOf": [ { "$ref": "#/definitions/device_binding_block" }, { "type": "null" } ] },
    "parity": { "anyOf": [ { "$ref": "#/definitions/parity_block" }, { "type": "null" } ] },
    "task": { "anyOf": [ { "$ref": "#/definitions/task_block" }, { "type": "null" } ] },
    "task_parity": { "anyOf": [ { "$ref": "#/definitions/task_parity_block" }, { "type": "null" } ] },
    "benchmark_data": { "anyOf": [ { "$ref": "#/definitions/benchmark_block" }, { "type": "null" } ] },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "type", "message"],
        "properties": {
          "stage": { "type": "string" },
          "type": { "type": "string" },
          "message": { "type": "string" },
          "stderr_excerpt": { "type": "string" }
        }
      }
    },
    "rca_issue_ids": { "type": "array", "items": { "type": "string" } },
    "contract": { "$ref": "#/definitions/receipt_contract" },
    "provenance": { "$ref": "#/definitions/provenance_block" }
  },
  "definitions": {
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "luid": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{8}:0x[0-9A-Fa-f]{8}$" },
    "ep_verdict": {
      "type": "object",
      "required": ["execution", "numeric_parity", "task_parity", "pt_app_smoke", "backend_routing", "benchmark"],
      "additionalProperties": false,
      "properties": {
        "execution": { "enum": ["PASS_FULL", "PASS_PARTIAL", "FAIL_NO_COMPUTE", "FAIL_RUNTIME", "NOT_RUN", "BLOCKED_EP", "BLOCKED_IDENTITY", "BLOCKED_RESOURCE"] },
        "numeric_parity": { "enum": ["PASS", "FAIL", "NOT_COMPARED"] },
        "task_parity": { "enum": ["PASS_TASK_PARITY", "FAIL_TASK_PARITY", "TASK_PARITY_NOT_IMPLEMENTED", "TASK_ORACLE_BLOCKED", "NOT_RUN"] },
        "pt_app_smoke": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "backend_routing": { "enum": ["BACKEND_UNVERIFIED", "CONFIRMED_HIP", "CONFIRMED_MIGRAPHX", "CONFIRMED_DIRECTML", "CONFIRMED_CPU"] },
        "benchmark": { "enum": ["MEASURED", "NOT_MEASURED"] }
      }
    },
    "verdicts": {
      "type": "object",
      "required": ["identity", "amdgpu", "dml"],
      "additionalProperties": false,
      "properties": {
        "identity": { "enum": ["EP_DEVICE_SELECTED", "PHYSICAL_GPU_IDENTITY_CORROBORATED", "IDENTITY_BINDING_UNPROVEN", "BLOCKED"] },
        "amdgpu": { "$ref": "#/definitions/ep_verdict" },
        "dml": { "$ref": "#/definitions/ep_verdict" }
      }
    },
    "input_block": {
      "type": "object",
      "required": ["input_id", "kind", "tensor_sha256"],
      "properties": {
        "input_id": { "$ref": "#/definitions/sha256_hex" },
        "kind": { "enum": ["real_image", "random_stress", "canary", "deterministic_synthetic"] },
        "image_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
        "tensor_sha256": { "type": "object", "additionalProperties": { "$ref": "#/definitions/sha256_hex" }, "minProperties": 1 },
        "preprocess": {
          "type": "object",
          "properties": {
            "method": { "type": "string" },
            "params": { "type": "object" },
            "pt_equivalence": { "type": "string" },
            "tensor_dtype": { "type": "string" },
            "tensor_shape": { "type": "array", "items": { "type": "integer" } }
          }
        },
        "npy_path_redacted": { "type": ["string", "null"] },
        "generation": {
          "type": "object",
          "properties": {
            "script": { "type": "string" },
            "canonical_config": { "type": "string" }
          }
        }
      }
    },
    "device_binding_block": {
      "type": "object",
      "required": ["ep", "state", "probe"],
      "properties": {
        "ep": { "enum": ["AMDGPU", "DML", "CPU"] },
        "state": { "enum": ["EP_DEVICE_SELECTED", "PHYSICAL_GPU_IDENTITY_CORROBORATED", "IDENTITY_BINDING_UNPROVEN"] },
        "selected_candidate_index": { "type": ["integer", "null"] },
        "candidates_tried": { "type": "integer", "minimum": 1 },
        "selected_ep_device": {
          "type": "object",
          "properties": {
            "ep_vendor": { "type": "string" },
            "ep_metadata": { "type": "object" },
            "ep_options": { "type": "object" }
          }
        },
        "probe": {
          "type": "object",
          "required": ["amdgpu_nodes"],
          "properties": {
            "amdgpu_nodes": { "type": "integer", "minimum": 0 },
            "cpu_nodes": { "type": "integer", "minimum": 0 },
            "profile_sha256": { "type": ["string", "null"] }
          }
        },
        "final_profile": {
          "type": "object",
          "properties": {
            "provider_node_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
            "profile_sha256": { "type": ["string", "null"] }
          }
        },
        "attribution": { "enum": ["fused_single_node", "multi_node", "none"] },
        "dxgi_corroboration": { "type": "object" },
        "notes": { "type": "string" }
      }
    },
    "host_block": {
      "type": "object",
      "required": ["host_id", "physical_gpu_name", "gfx", "os_build", "driver_version", "verified_device_identity"],
      "properties": {
        "host_id": { "type": "string" },
        "physical_gpu_name": { "type": "string" },
        "gfx": { "enum": ["gfx1151", "gfx1100", "gfx1201", "unknown"] },
        "device_luid": { "type": ["string", "null"] },
        "dxgi_evidence": { "type": "object" },
        "pnp_evidence": { "type": "object" },
        "os_build": { "type": "string" },
        "driver_version": { "type": "string" },
        "driver_date": { "type": ["string", "null"] },
        "wddm_version": { "type": ["string", "null"] },
        "verified_device_identity": { "type": "boolean" },
        "identity_method": { "type": "string" },
        "canary": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "executed_on_target": { "type": "boolean" },
            "detail": { "type": "object" }
          }
        }
      }
    },
    "model_block": {
      "type": "object",
      "required": ["family", "task", "checkpoint"],
      "properties": {
        "family": { "type": "string" },
        "task": { "type": "string" },
        "checkpoint": { "type": "string" },
        "size": { "type": ["string", "null"] },
        "pt_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
        "onnx_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
        "onnx_path_redacted": { "type": "string" },
        "export": {
          "type": "object",
          "properties": {
            "imgsz": { "type": "integer" },
            "opset": { "type": "integer" },
            "dynamic": { "type": "boolean" },
            "batch": { "type": "integer" },
            "nms_mode": { "enum": ["raw", "embedded_nms", "nms_free_head"] },
            "quantize": { "enum": ["fp32", "fp16", "int8"] },
            "args": { "type": "object" },
            "ultralytics_version": { "type": "string" }
          }
        },
        "input_names": { "type": "array", "items": { "type": "string" } },
        "output_names": { "type": "array", "items": { "type": "string" } },
        "inputs_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] }
      }
    },
    "session_block": {
      "type": "object",
      "properties": {
        "ep": { "enum": ["AMDGPU", "DML", "CPU"] },
        "requested_providers": { "type": "array", "items": { "type": "string" } },
        "providers_after_create": { "type": "array", "items": { "type": "string" } },
        "ep_library_path_redacted": { "type": ["string", "null"] },
        "ep_library_sha256": { "type": ["string", "null"] },
        "ep_msix_package": { "type": ["string", "null"] },
        "ort_version": { "type": "string" },
        "ort_distribution": { "type": "string" },
        "provider_node_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "graph_node_total": { "type": "integer", "minimum": 0 },
        "profile_available": { "type": "boolean" },
        "profile_sha256": { "type": ["string", "null"] },
        "profile_fused_event_present": { "type": "boolean" },
        "routing_notes": { "type": "string" },
        "stderr_fallback_signals": { "type": "array", "items": { "type": "string" } },
        "stdout_fallback_signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "parity_block": {
      "type": "object",
      "required": ["outputs", "all_outputs_allclose", "by_name_matching"],
      "properties": {
        "reference": { "enum": ["CPU_ORT", "CPU_ORT_INT8"] },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "shape", "dtype", "finite", "max_abs_diff", "mean_abs_diff", "allclose"],
            "properties": {
              "name": { "type": "string" },
              "shape": { "type": "array", "items": { "type": "integer" } },
              "dtype": { "type": "string" },
              "finite": { "type": "boolean" },
              "max_abs_diff": { "type": ["number", "null"] },
              "mean_abs_diff": { "type": ["number", "null"] },
              "max_rel_diff": { "type": "number" },
              "p99_abs_diff": { "type": "number" },
              "allclose": { "type": "boolean" },
              "threshold_used": { "type": "number" },
              "candidate_sha256": { "type": "string" },
              "ref_sha256": { "type": "string" }
            }
          }
        },
        "all_outputs_allclose": { "type": "boolean" },
        "by_name_matching": { "type": "boolean" },
        "thresholds": {
          "type": "object",
          "properties": {
            "atol": { "type": "number" },
            "rtol": { "type": "number" },
            "source": { "type": "string" }
          }
        }
      }
    },
    "task_block": {
      "type": "object",
      "properties": {
        "oracle_kind": { "enum": ["PT_APP", "TASK_PARITY", "ANNOTATED_METRIC", "STRUCTURAL"] },
        "metrics": { "type": "object" },
        "passed": { "type": "boolean" },
        "summary": { "type": "string" }
      }
    },
    "task_parity_block": {
      "type": "object",
      "required": ["oracle_kind", "ref_source", "cand_source", "metrics", "thresholds_declared", "passed"],
      "properties": {
        "oracle_kind": { "const": "TASK_PARITY" },
        "task": { "type": "string" },
        "image_sha256": { "$ref": "#/definitions/sha256_hex" },
        "input_id": { "$ref": "#/definitions/sha256_hex" },
        "ref_source": { "enum": ["PT_ULTRALYTICS", "CPU_ORT_POST"] },
        "cand_source": { "enum": ["AMDGPU_POST", "DML_POST", "CPU_ORT_POST"] },
        "ref_fingerprint_sha256": { "type": "string" },
        "cand_fingerprint_sha256": { "type": "string" },
        "metrics": { "type": "object" },
        "thresholds_declared": { "type": "object" },
        "thresholds_source": { "type": "string" },
        "passed": { "type": "boolean" },
        "four_way": {
          "type": "object",
          "properties": {
            "pt_post_fingerprint": { "type": "string" },
            "cpu_ort_post_fingerprint": { "type": "string" },
            "amdgpu_post_fingerprint": { "type": "string" },
            "dml_post_fingerprint": { "type": "string" }
          }
        },
        "negative_control": {
          "type": ["object", "null"],
          "properties": {
            "image_sha256": { "$ref": "#/definitions/sha256_hex" },
            "ref_empty": { "type": "boolean" },
            "cand_empty": { "type": "boolean" },
            "discriminating": { "type": "boolean" }
          }
        },
        "not_implemented_reason": { "type": ["string", "null"] }
      }
    },
    "benchmark_block": {
      "type": "object",
      "properties": {
        "ep_registration_ms": { "type": "number" },
        "session_create_ms": { "type": "number" },
        "first_run_ms": { "type": "number" },
        "cold_start_total_ms": { "type": "number" },
        "warm_run_ms_p50": { "type": "number" },
        "warm_run_ms_p95": { "type": "number" },
        "warm_run_ms_p99": { "type": "number" },
        "warm_run_ms_mean": { "type": "number" },
        "warm_run_ms_std": { "type": "number" },
        "warm_run_samples": { "type": "integer", "minimum": 1 },
        "preprocess_ms_mean": { "type": "number" },
        "postprocess_ms_mean": { "type": "number" },
        "e2e_image_ms_p50": { "type": "number" },
        "timer": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "provenance_block": {
      "type": "object",
      "required": ["script_head_sha", "command", "seed"],
      "properties": {
        "script_head_sha": { "type": "string" },
        "command": { "type": "string" },
        "seed": { "type": "integer" },
        "python_version": { "type": "string" },
        "ultralytics_version": { "type": ["string", "null"] },
        "raw_log_path_redacted": { "type": ["string", "null"] },
        "raw_log_sha256": { "type": ["string", "null"] },
        "env_fingerprint": { "type": "object" }
      }
    },
    "receipt_contract": {
      "type": "object",
      "required": ["run_contract_sha256", "code", "thresholds_sha256",
                   "device_identity", "ep", "model", "input"],
      "properties": {
        "run_contract_sha256": { "$ref": "#/definitions/sha256_hex" },
        "code": {
          "type": "object",
          "required": ["git_head_sha", "harness_sha256", "worktree_dirty"],
          "properties": {
            "git_head_sha": { "type": "string" },
            "harness_sha256": { "$ref": "#/definitions/sha256_hex" },
            "worktree_dirty": { "type": "boolean" }
          }
        },
        "thresholds_sha256": { "$ref": "#/definitions/sha256_hex" },
        "device_identity": {
          "type": "object",
          "required": ["gfx", "host_id", "vendor_id", "device_id"],
          "properties": {
            "gfx": { "type": "string" },
            "host_id": { "type": "string" },
            "vendor_id": { "type": "string" },
            "device_id": { "type": "string" },
            "physical_gpu_name": { "type": ["string", "null"] },
            "luid": { "type": ["string", "null"] },
            "identity_method": { "type": ["string", "null"] },
            "did_match": { "type": "boolean" }
          }
        },
        "environment": {
          "type": "object",
          "description": "Runtime binding (python/ORT/Windows ML versions) captured with the run contract; drift forbids resume.",
          "properties": {
            "python_executable_name": { "type": ["string", "null"] },
            "python_version": { "type": ["string", "null"] },
            "os_build": { "type": ["string", "null"] },
            "ort_version": { "type": ["string", "null"] },
            "ort_distribution": { "type": ["string", "null"] },
            "ort_providers": { "type": "array", "items": { "type": "string" } },
            "windowsml_version": { "type": ["string", "null"] },
            "probe_error": { "type": ["string", "null"] }
          }
        },
        "ep": { "enum": ["amdgpu", "dml"] },
        "model": {
          "type": "object",
          "properties": {
            "checkpoint": { "type": ["string", "null"] },
            "pt_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
            "onnx_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] }
          }
        },
        "input": {
          "type": "object",
          "properties": {
            "input_id": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
            "image_sha256": { "anyOf": [ { "$ref": "#/definitions/sha256_hex" }, { "type": "null" } ] },
            "tensor_sha256": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/sha256_hex" }
            }
          }
        }
      }
    }
  }
}
