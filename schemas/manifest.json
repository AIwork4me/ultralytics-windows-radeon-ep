{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AIwork4me/ultralytics-windows-radeon-ep/schemas/manifest.json",
  "title": "UWR evidence manifest (sha256)",
  "type": "object",
  "required": ["schema_version", "run_id", "created_utc", "generator", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string" },
    "created_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "generator": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "repo-relative POSIX path, no absolute user paths" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
